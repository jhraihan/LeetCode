    "Two Sum"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 1,
   "id": "855f3731",
   "metadata": {},
   "outputs": [],
   "source": [
    "class Solution(object):\n",
    "    def twoSum(self, nums, target):\n",
    "        seen = {}\n",
    "        for i, num in enumerate(nums):\n",
    "            comp = target-num\n",
    "            if comp in seen:\n",
    "                return [seen[comp], i]\n",
    "            seen[num] = i\n",
    "        return []"
   ]
  }
