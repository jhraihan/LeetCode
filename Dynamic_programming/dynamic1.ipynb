   "source": [
    "Climbing Stairs"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 1,
   "id": "fc891b2a",
   "metadata": {},
   "outputs": [],
   "source": [
    "class Solution(object):\n",
    "    def climbStairs(self, n):\n",
    "        if n == 1:\n",
    "            return 1\n",
    "        ways = [0] * (n+1)\n",
    "        ways[1] = 1\n",
    "        ways[2] = 2\n",
    "        for i in range(3,n+1):\n",
    "            ways[i] = ways[i-1] + ways[i-2]\n",
    "        return ways[n]\n",
    "        "
   ]
  }
